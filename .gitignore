# ==========================================
# Build Tools & Outputs
# ==========================================
target/
build/
out/
bin/

# Maven/Gradle wrappers should be tracked, but ignore local overrides or cache
.gradle/
.m2/
.mvn/timing.properties

# Ensure wrapper JAR files are NOT ignored (reverses general rule if *.jar is added later)
!/.mvn/wrapper/maven-wrapper.jar
!/gradle/wrapper/gradle-wrapper.jar

