# Copy to .env and fill every secret in. Values are intentionally blank: services
# fail to start when a required secret is missing rather than falling back to a
# shared committed default (S1 / P0-SEC-02).
# Generate one with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

PORT=8003
GRPC_PORT=50056
DB_URL=jdbc:postgresql://localhost:5437/kinetix_payment_dev
DB_USERNAME=kinetix_payment_app
DB_PASSWORD=
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
IDENTITY_JWKS_URL=http://kinetix-identity-service:5000/.well-known/jwks.json
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix
GRPC_ALLOWED_CALLERS=order,notary@payment.v1.LiabilityService,notary-watch@payment.v1.LiabilityRecordService
TOP_UP_MAXIMUM_AMOUNT=2000000
CUSTOMER_WALLET_MAXIMUM_BALANCE=2000000
